msgid "Restaurant Menu"
msgstr "Restoran menyusi"

msgid "Menu"
msgstr "Menyu"

msgid "Our Menu"
msgstr "Bizning menyu"

msgid "No table detected. Please scan the QR code on your table to start an order."
msgstr "Stol aniqlanmadi. Buyurtma berish uchun stolingizdagi QR-kodni skanerlang."

msgid "items"
msgstr "ta mahsulot"

