# Copy this file to .env and fill in real values. Never commit .env.

# --- Core Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (leave blank to use local SQLite) ---
# If set, PostgreSQL is used instead of SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# --- Telegram Bot (Admin verification) ---
# Create a bot with @BotFather, copy the token here.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_BOT_USERNAME=YourRestaurantAdminBot
# Public HTTPS URL Telegram will POST updates to, e.g. via ngrok or your domain.
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret

# --- Geo-Verification ---
# Restaurant's true coordinates and the acceptable radius (meters).
RESTAURANT_LATITUDE=41.311081
RESTAURANT_LONGITUDE=69.240562
GEO_ALLOWED_RADIUS_METERS=150
# Max age (minutes) between photo capture (EXIF or upload time) and submission.
PHOTO_MAX_AGE_MINUTES=5
