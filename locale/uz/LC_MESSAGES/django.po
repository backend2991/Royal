msgid "Photo must be taken right now, from inside the restaurant."
msgstr "Surat hozir, restoran ichida olinishi kerak."

msgid "Requesting your location…"
msgstr "Joylashuvingiz so'ralmoqda…"

msgid "Location confirmed."
msgstr "Joylashuv tasdiqlandi."

msgid "Location access denied. Please enable it to place your order."
msgstr "Joylashuvga ruxsat berilmadi. Buyurtma berish uchun uni yoqing."

msgid "Location is not supported on this device."
msgstr "Bu qurilmada joylashuv xizmati qo'llab-quvvatlanmaydi."

msgid "Camera access denied or unavailable. Please allow camera permission."
